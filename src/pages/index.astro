---
import BaseLayout from "../layouts/BaseLayout.astro";
import { categories } from "../data/categories";
import { formatPostDate, posts } from "../data/posts";
import { site } from "../data/site";
---

<BaseLayout title={site.title} description={site.description}>
  <main>
    <section class="intro-band">
      <div class="intro-copy">
        <p class="eyebrow">AI & Education Notes</p>
        <h1>
          <span>把 AI 時代的教育問題，</span>
          <span>寫成父母與教育者</span>
          <span>都讀得懂的思考。</span>
        </h1>
        <p class="intro-text">
          <span>從家庭、教室到社會，</span>
          <span>整理那些真正影響孩子成長的底層判斷。</span>
        </p>
      </div>
      <figure class="intro-media">
        <img
          src="/images/ai-education-hero.png"
          alt="溫暖書桌上的筆記本、平板、教育書籍與 AI 學習網絡概念圖像"
          width="1200"
          height="675"
        />
      </figure>
    </section>

    <section class="category-band" aria-labelledby="category-title">
      <div class="section-heading">
        <p class="eyebrow">Categories</p>
        <h2 id="category-title">文章分類</h2>
      </div>
      <div class="category-controls" role="group" aria-label="文章分類篩選">
        <a class="category-pill is-active" href="/#articles" data-filter="all" aria-pressed="true">
          全部
        </a>
        {
          categories.map((category) => (
            <a
              class="category-pill"
              href={`/?category=${category.id}#articles`}
              data-filter={category.id}
              aria-pressed="false"
              style={`--accent:${category.accent}`}
            >
              {category.label}
            </a>
          ))
        }
      </div>
      <div class="category-notes">
        {
          categories.map((category) => (
            <p data-category-note={category.id}>
              <span style={`--accent:${category.accent}`}></span>
              <strong>{category.label}</strong>
              {category.summary}
            </p>
          ))
        }
      </div>
    </section>

    <section class="article-band" id="articles" aria-labelledby="articles-title">
      <div class="section-heading">
        <p class="eyebrow">Latest Writing</p>
        <h2 id="articles-title">最新文章</h2>
      </div>

      <div class="article-grid" data-article-grid>
        {
          posts.map((post) => (
            <article class="post-card" data-categories={post.categories.join(" ")}>
              <a href={`/posts/${post.slug}/`} class="post-card-media">
                {post.coverImage && (
                  <img src={post.coverImage} alt={post.coverAlt ?? ""} width="1200" height="675" />
                )}
              </a>
              <div class="post-card-body">
                <div class="post-meta">
                  <span>{post.kicker}</span>
                  <time datetime={post.date}>{formatPostDate(post.date)}</time>
                </div>
                <h3>
                  <a href={`/posts/${post.slug}/`}>{post.title}</a>
                </h3>
                <p>{post.excerpt}</p>
                <div class="post-tags" aria-label="文章分類">
                  {
                    post.categories.map((categoryId) => {
                      const category = categories.find((item) => item.id === categoryId);
                      return category ? (
                        <a href={`/?category=${category.id}#articles`} data-tag-filter={category.id}>
                          {category.label}
                        </a>
                      ) : null;
                    })
                  }
                </div>
              </div>
            </article>
          ))
        }
      </div>
      <p class="empty-state" data-empty-state hidden>這個分類的文章正在整理中。</p>
    </section>

    <section class="contact-band" id="contact" aria-labelledby="contact-title">
      <div class="section-heading">
        <p class="eyebrow">Connect & Contact</p>
        <h2 id="contact-title">與我聯繫</h2>
      </div>
      
      <div class="contact-card">
        <div class="contact-card-content">
          <h3>交流與合作</h3>
          <p>
            對 AI 時代的教育、親子陪伴與學習法有任何想法，或有講座、專案合作的邀請？<br />
            歡迎透過 Facebook 粉絲專頁或 LINE 與我取得聯繫！
          </p>
        </div>
        <div class="contact-links">
          <a href={site.social.facebook} target="_blank" rel="noopener noreferrer" class="contact-btn facebook-btn" aria-label="前往 Facebook 粉絲專頁">
            <svg class="contact-icon" viewBox="0 0 24 24" fill="currentColor">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
            <div class="btn-text">
              <span class="btn-label">Facebook 粉絲專頁</span>
              <span class="btn-subtext">追蹤最新動態與育兒手記</span>
            </div>
          </a>
          <a href={site.social.line} target="_blank" rel="noopener noreferrer" class="contact-btn line-btn" aria-label="加入 LINE 官方帳號">
            <svg class="contact-icon" viewBox="0 0 24 24" fill="currentColor">
              <path d="M24 10.304c0-5.369-5.383-9.738-12-9.738-6.616 0-12 4.369-12 9.738 0 4.814 4.269 8.843 10.06 9.603.391.084.924.258 1.058.596.12.301.079.773.038 1.077l-.223 1.34c-.067.404-.325 1.583 1.398.864 1.724-.718 9.3-5.468 12.673-9.351 2.628-3.093 3.998-5.91 3.998-8.129zm-16.926 2.378h-1.636a.37.37 0 01-.371-.371V7.94a.37.37 0 01.371-.371h.247a.37.37 0 01.371.371v.334h1.018a.37.37 0 01.371.371v.273a.37.37 0 01-.371.372.007.007 0 01-.001 0zm2.256-.371a.37.37 0 01-.371.371h-.248a.37.37 0 01-.371-.371V7.94a.37.37 0 01.371-.371h.248a.37.37 0 01.371.371v4.372zm6.273 0a.37.37 0 01-.371.371h-.272a.37.37 0 01-.371-.371l-1.921-2.613v2.242c0 .205-.166.371-.371.371h-.248a.37.37 0 01-.371-.371V7.94a.37.37 0 01.371-.371h.273a.37.37 0 01.371.371l1.92 2.613V7.94a.37.37 0 01.371-.371h.248a.37.37 0 01.371.371v4.372zm3.328-1.748h-1.143v1.077h1.143a.37.37 0 01.371.371v.273a.37.37 0 01-.371.371h-1.761a.37.37 0 01-.371-.371V7.94a.37.37 0 01.371-.371h.761c.205 0 .371.166.371.371v.273a.37.37 0 01-.371.371h-.761V9.89h1.143a.37.37 0 01.371.371v.273a.37.37 0 01-.371.371z"/>
            </svg>
            <div class="btn-text">
              <span class="btn-label">LINE 官方帳號</span>
              <span class="btn-subtext">即時一對一交流與溝通</span>
            </div>
          </a>
        </div>
      </div>
    </section>
  </main>

  <script>
    const buttons = Array.from(document.querySelectorAll("[data-filter]"));
    const cards = Array.from(document.querySelectorAll("[data-categories]"));
    const notes = Array.from(document.querySelectorAll("[data-category-note]"));
    const emptyState = document.querySelector("[data-empty-state]");
    const title = document.querySelector("#articles-title");

    function setFilter(filter) {
      const activeFilter = filter || "all";
      let visibleCount = 0;

      buttons.forEach((button) => {
        const isActive = button.getAttribute("data-filter") === activeFilter;
        button.classList.toggle("is-active", isActive);
        button.setAttribute("aria-pressed", String(isActive));
      });

      notes.forEach((note) => {
        const isVisible =
          activeFilter === "all" || note.getAttribute("data-category-note") === activeFilter;
        note.toggleAttribute("hidden", !isVisible);
      });

      cards.forEach((card) => {
        const categories = (card.getAttribute("data-categories") || "").split(" ");
        const isVisible = activeFilter === "all" || categories.includes(activeFilter);
        card.toggleAttribute("hidden", !isVisible);
        if (isVisible) visibleCount += 1;
      });

      if (emptyState) emptyState.toggleAttribute("hidden", visibleCount > 0);
      if (title) title.textContent = activeFilter === "all" ? "最新文章" : "分類文章";
    }

    const initialCategory = new URLSearchParams(window.location.search).get("category");
    setFilter(initialCategory);

    buttons.forEach((button) => {
      button.addEventListener("click", (e) => {
        e.preventDefault();
        const filter = button.getAttribute("data-filter");
        setFilter(filter);

        const newUrl = filter === "all" ? "/" : `/?category=${filter}`;
        window.history.pushState({ category: filter }, "", newUrl);

        document.querySelector("#articles")?.scrollIntoView({ behavior: "smooth" });
      });
    });

    const tagFilters = Array.from(document.querySelectorAll("[data-tag-filter]"));
    tagFilters.forEach((tag) => {
      tag.addEventListener("click", (e) => {
        e.preventDefault();
        const filter = tag.getAttribute("data-tag-filter");
        setFilter(filter);

        const newUrl = `/?category=${filter}`;
        window.history.pushState({ category: filter }, "", newUrl);

        document.querySelector("#articles")?.scrollIntoView({ behavior: "smooth" });
      });
    });

    window.addEventListener("popstate", (e) => {
      const category = e.state?.category || new URLSearchParams(window.location.search).get("category");
      setFilter(category);
    });
  </script>
</BaseLayout>
