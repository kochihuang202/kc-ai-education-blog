---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { categories, getCategory } from "../../data/categories";
import { formatPostDate, posts, type Post } from "../../data/posts";
import { site } from "../../data/site";

export function getStaticPaths() {
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const title = `${post.title}｜${site.name}`;
const relatedPosts =
  post.relatedPosts.length > 0
    ? posts.filter((item) => post.relatedPosts.includes(item.slug))
    : posts
        .filter(
          (item) =>
            item.slug !== post.slug && item.categories.some((category) => post.categories.includes(category))
        )
        .slice(0, 3);

const bullyingTrilogy = [
  {
    slug: "school-and-workplace-bullying",
    title: "第一部：有手段 ｜ 學校與職場的霸凌層出不窮：我們到底少教了孩子什麼？"
  },
  {
    slug: "not-all-harm-is-bullying",
    title: "第二部：會分辨 ｜ 不是所有傷害都叫霸凌：孩子要先學會分辨這三件事"
  },
  {
    slug: "how-high-can-an-unswayed-person-go",
    title: "第三部：放得下 ｜ 不被左右的人，能走到什麼高度？"
  }
];
const inBullyingTrilogy = post.categories.includes("facing-bullying");
---

<BaseLayout title={title} description={post.excerpt} image={post.coverImage} type="article">
  <main class="article-page">
    <nav class="breadcrumb" aria-label="文章路徑">
      <a href="/">首頁</a>
      <span>/</span>
      <span>{post.title}</span>
    </nav>

    <article class="article-shell">
      <header class="article-header">
        <p class="eyebrow">{post.kicker}</p>
        <h1>{post.title}</h1>
        <p>{post.excerpt}</p>
        <div class="article-meta">
          <time datetime={post.date}>{formatPostDate(post.date)}</time>
          <div class="post-tags" aria-label="文章分類">
            {
              post.categories.map((categoryId) => {
                const category = getCategory(categoryId);
                return category ? (
                  <a href={`/?category=${category.id}#articles`} style={`--accent:${category.accent}`}>
                    {category.label}
                  </a>
                ) : null;
              })
            }
          </div>
        </div>
      </header>

      {
        post.gallery ? (
          <section class="article-gallery" data-gallery-root aria-label={`${post.title}圖文解析輪播`}>
            <div class="gallery-toolbar">
              <span class="gallery-label">{post.gallery.label}</span>
              <span class="gallery-counter" data-gallery-counter aria-live="polite">
                1 / {post.gallery.images.length}
              </span>
            </div>
            <div class="gallery-frame">
              <button class="gallery-nav gallery-nav-prev" type="button" data-gallery-prev aria-label="上一張">
                <span aria-hidden="true">‹</span>
              </button>
              <button class="gallery-image-button" type="button" data-gallery-open aria-label="放大圖文解析">
                {post.gallery.images.map((image, index) => (
                  <img
                    class={index === 0 ? "gallery-slide is-active" : "gallery-slide"}
                    src={image.src}
                    alt={image.alt}
                    width="1080"
                    height="1440"
                    loading={index === 0 ? "eager" : "lazy"}
                    data-gallery-slide={String(index)}
                    hidden={index !== 0}
                  />
                ))}
              </button>
              <button class="gallery-nav gallery-nav-next" type="button" data-gallery-next aria-label="下一張">
                <span aria-hidden="true">›</span>
              </button>
            </div>
            <div class="gallery-dots" aria-label="圖文解析頁數">
              {post.gallery.images.map((_, index) => (
                <button
                  class={index === 0 ? "is-active" : ""}
                  type="button"
                  data-gallery-dot={String(index)}
                  aria-label={`第 ${index + 1} 張`}
                  aria-current={index === 0 ? "true" : "false"}
                />
              ))}
            </div>
            <div class="gallery-lightbox" data-gallery-lightbox role="dialog" aria-modal="true" aria-label="圖文解析全螢幕輪播" hidden>
              <button class="lightbox-close" type="button" data-lightbox-close aria-label="關閉">×</button>
              <button class="lightbox-nav lightbox-prev" type="button" data-lightbox-prev aria-label="上一張">
                <span aria-hidden="true">‹</span>
              </button>
              <img data-lightbox-image alt="" />
              <button class="lightbox-nav lightbox-next" type="button" data-lightbox-next aria-label="下一張">
                <span aria-hidden="true">›</span>
              </button>
              <span class="lightbox-counter" data-lightbox-counter>1 / {post.gallery.images.length}</span>
            </div>
          </section>
        ) : (
          post.coverImage && (
            <figure class="article-cover">
              <img src={post.coverImage} alt={post.coverAlt ?? ""} width="1200" height="675" />
            </figure>
          )
        )
      }

      {
        inBullyingTrilogy && (
          <div class="trilogy-nav">
            <div class="trilogy-title">
              📚 專題系列：面對霸凌三部曲
            </div>
            <div class="trilogy-steps">
              {bullyingTrilogy.map((item, index) => {
                const isActive = item.slug === post.slug;
                const num = index + 1;
                return isActive ? (
                  <div class="trilogy-step is-active">
                    <span class="step-num">{num}</span>
                    <span class="step-text">{item.title}</span>
                  </div>
                ) : (
                  <a href={`/posts/${item.slug}/`} class="trilogy-step">
                    <span class="step-num">{num}</span>
                    <span class="step-text">{item.title}</span>
                  </a>
                );
              })}
            </div>
          </div>
        )
      }

      <div class="article-body" set:html={post.body} />
    </article>

    <section class="related-band" aria-labelledby="related-title">
      <div class="section-heading">
        <p class="eyebrow">Keep Reading</p>
        <h2 id="related-title">延伸閱讀</h2>
      </div>
      {
        relatedPosts.length > 0 ? (
          <div class="related-list">
            {relatedPosts.map((related) => (
              <a href={`/posts/${related.slug}/`} class="related-link">
                <span>{related.kicker}</span>
                <strong>{related.title}</strong>
              </a>
            ))}
          </div>
        ) : (
          <div class="related-list">
            {categories
              .filter((category) => post.categories.includes(category.id))
              .map((category) => (
                <a href={`/?category=${category.id}#articles`} class="related-link">
                  <span>{category.label}</span>
                  <strong>{category.summary}</strong>
                </a>
              ))}
          </div>
        )
      }
    </section>
  </main>

  <script>
    document.querySelectorAll("[data-gallery-root]").forEach((root) => {
      const slides = Array.from(root.querySelectorAll("[data-gallery-slide]"));
      const dots = Array.from(root.querySelectorAll("[data-gallery-dot]"));
      const counter = root.querySelector("[data-gallery-counter]");
      const lightbox = root.querySelector("[data-gallery-lightbox]");
      const lightboxImage = root.querySelector("[data-lightbox-image]");
      const lightboxCounter = root.querySelector("[data-lightbox-counter]");
      const closeButton = root.querySelector("[data-lightbox-close]");
      let current = 0;
      let touchStartX = 0;

      function update(index) {
        current = (index + slides.length) % slides.length;
        const text = `${current + 1} / ${slides.length}`;

        slides.forEach((slide, slideIndex) => {
          const isActive = slideIndex === current;
          slide.toggleAttribute("hidden", !isActive);
          slide.classList.toggle("is-active", isActive);
        });

        dots.forEach((dot, dotIndex) => {
          const isActive = dotIndex === current;
          dot.classList.toggle("is-active", isActive);
          dot.setAttribute("aria-current", String(isActive));
        });

        if (counter) counter.textContent = text;
        if (lightboxCounter) lightboxCounter.textContent = text;
        if (lightboxImage && slides[current]) {
          const activeImage = slides[current];
          lightboxImage.setAttribute("src", activeImage.currentSrc || activeImage.getAttribute("src") || "");
          lightboxImage.setAttribute("alt", activeImage.getAttribute("alt") || "");
        }
      }

      function openLightbox() {
        update(current);
        if (!lightbox) return;
        lightbox.hidden = false;
        document.body.classList.add("gallery-open");
        closeButton?.focus();
      }

      function closeLightbox() {
        if (!lightbox) return;
        lightbox.hidden = true;
        document.body.classList.remove("gallery-open");
      }

      root.querySelector("[data-gallery-prev]")?.addEventListener("click", () => update(current - 1));
      root.querySelector("[data-gallery-next]")?.addEventListener("click", () => update(current + 1));
      root.querySelector("[data-gallery-open]")?.addEventListener("click", openLightbox);
      root.querySelector("[data-lightbox-prev]")?.addEventListener("click", () => update(current - 1));
      root.querySelector("[data-lightbox-next]")?.addEventListener("click", () => update(current + 1));
      closeButton?.addEventListener("click", closeLightbox);
      dots.forEach((dot) => {
        dot.addEventListener("click", () => update(Number(dot.getAttribute("data-gallery-dot"))));
      });

      lightbox?.addEventListener("click", (event) => {
        if (event.target === lightbox) closeLightbox();
      });

      lightbox?.addEventListener("touchstart", (event) => {
        touchStartX = event.changedTouches[0]?.clientX ?? 0;
      });

      lightbox?.addEventListener("touchend", (event) => {
        const touchEndX = event.changedTouches[0]?.clientX ?? 0;
        const delta = touchEndX - touchStartX;
        if (Math.abs(delta) < 42) return;
        update(delta < 0 ? current + 1 : current - 1);
      });

      document.addEventListener("keydown", (event) => {
        if (!lightbox || lightbox.hidden) return;
        if (event.key === "Escape") closeLightbox();
        if (event.key === "ArrowLeft") update(current - 1);
        if (event.key === "ArrowRight") update(current + 1);
      });

      update(0);
    });
  </script>
</BaseLayout>
